{
  "platform_contract": {
    "config_files": [
      ".openclaw/openclaw.json",
      "_scan_only/.openclaw/agents/main/agent/auth-profiles.json"
    ],
    "env_vars": {}
  },
  "url_proxy_os_fallback_names": [
    "OPENCLAW_LIVE_OPENAI_KEY",
    "OPENAI_API_KEYS",
    "OPENAI_API_KEY",
    "OPENCLAW_LIVE_ANTHROPIC_KEY",
    "OPENCLAW_LIVE_ANTHROPIC_KEYS",
    "ANTHROPIC_API_KEYS",
    "ANTHROPIC_API_KEY",
    "OPENCLAW_LIVE_GEMINI_KEY",
    "GEMINI_API_KEYS",
    "GEMINI_API_KEY",
    "GOOGLE_API_KEY"
  ],
  "discovery_skill_precedence": [
    "workspace/skills",
    "workspace/.agents/skills",
    ".agents/skills",
    ".openclaw/skills",
    "bundled/skills",
    "skills.load.extraDirs"
  ],
  "skill_roots": [],
  "fixed_scan_files": [
    {
      "base": "runtime_dir",
      "path": "AGENTS.md",
      "display_path": ".openclaw/workspace/AGENTS.md"
    },
    {
      "base": "runtime_dir",
      "path": "SOUL.md",
      "display_path": ".openclaw/workspace/SOUL.md"
    },
    {
      "base": "runtime_dir",
      "path": "TOOLS.md",
      "display_path": ".openclaw/workspace/TOOLS.md"
    },
    {
      "base": "runtime_dir",
      "path": "USER.md",
      "display_path": ".openclaw/workspace/USER.md"
    },
    {
      "base": "runtime_dir",
      "path": "HEARTBEAT.md",
      "display_path": ".openclaw/workspace/HEARTBEAT.md"
    },
    {
      "base": "runtime_dir",
      "path": "MEMORY.md",
      "display_path": ".openclaw/workspace/MEMORY.md"
    },
    {
      "base": "runtime_dir",
      "path": "memory.md",
      "display_path": ".openclaw/workspace/memory.md"
    },
    {
      "base": "runtime_dir",
      "path": "README.md",
      "display_path": ".openclaw/workspace/README.md"
    },
    {
      "base": "home",
      "path": ".openclaw/agents/main/agent/auth-profiles.json",
      "display_path": ".openclaw/agents/main/agent/auth-profiles.json"
    }
  ],
  "runtime_env": {
    "field": "openclaw_version",
    "command": [
      "openclaw",
      "--version"
    ]
  }
}
