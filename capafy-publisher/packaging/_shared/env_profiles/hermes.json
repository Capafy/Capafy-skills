  "url_proxy_os_fallback_names": [],
  "discovery_skill_precedence": [
    ".hermes/skills"
  ],
  "skill_roots": [
    {
      "base": "home",
      "path": ".hermes/skills",
      "display_prefix": ".hermes/skills",
      "target_path": ".hermes/skills",
      "source_key": ".hermes/skills",
      "source_value": "copied",
      "skip_skill_runtime_outputs": true,
      "excluded_relpath_prefixes": [
        "sessions",
        "memories",
        "logs",
        "credentials",
        "oauth",
        "auth",
        "worktrees"
      ]
    }
  ],
  "fixed_scan_files": [
    {
      "base": "home",
      "path": ".hermes/config.yaml",
      "display_path": ".hermes/config.yaml"
    },
    {
      "base": "home",
      "path": ".hermes/.env",
      "display_path": ".hermes/.env"
    },
    {
      "base": "home",
      "path": ".hermes/SOUL.md",
      "display_path": ".hermes/SOUL.md"
    },
    {
      "base": "home",
      "path": ".hermes/memories/MEMORY.md",
      "display_path": ".hermes/memories/MEMORY.md"
    },
    {
      "base": "home",
      "path": ".hermes/memories/USER.md",
      "display_path": ".hermes/memories/USER.md"
    },
    {
      "base": "runtime_dir",
      "path": ".hermes.md",
      "display_path": "workspace/.hermes.md"
    },
    {
      "base": "runtime_dir",
      "path": "HERMES.md",
      "display_path": "workspace/HERMES.md"
    },
    {
